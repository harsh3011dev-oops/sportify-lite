{
  "name": "sportify-desktop",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.sportify.desktop",
    "productName": "Sportify",
    "win": {
